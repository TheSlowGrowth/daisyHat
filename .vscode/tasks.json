{
    // See https://code.visualstudio.com/docs/editor/tasks
    // for the documentation about the tasks.json format.
    //
    // The tasks use the local python venv at .venv (gitignored).
    // Create/update it with:
    //   python3 -m venv .venv && .venv/bin/pip install -e .
    //
    // The workspace root .env file (gitignored, see .env.example) is loaded
    // automatically, so the local seed config override applies here.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "daisyhat: test (selftests)",
            "detail": "Build and run the on-device assertion self-tests (requires the Daisy Seed and its debug probe from the local config)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/daisyhat",
            "args": ["test", "selftests"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "daisyhat: clean (selftests)",
            "detail": "Remove the build directories of the self-tests",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/daisyhat",
            "args": ["clean", "selftests"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        }
    ]
}
