# Copy to .env (gitignored) and adapt for local development.
# Values already present in the process environment are NOT overridden.
#
# Path to a libDaisy checkout (e.g. a sibling of this repo, or a checkout in
# a consumer repo). Required for building firmware.
LIBDAISY_DIR=/path/to/libDaisy

# Prefix of the ARM GCC toolchain: a directory that contains
# bin/arm-none-eabi-gcc, bin/arm-none-eabi-g++ and bin/arm-none-eabi-objcopy
TOOLCHAIN_PREFIX=/path/to/arm-toolchain

# Use a local (gitignored) daisyHat config file instead of the committed
# daisyHat.config.json, e.g. for machine specific serial device paths.
# Path is resolved relative to the directory the CLI is started from.
#DAISYHAT_CONFIG_FILE_OVERRIDE=path/to/daisyHat.config.local.json

# Enable verbose logging of the pyocd flash backend (DEBUG, INFO, ...).
# Useful for investigating probe/flash errors.
#DAISYHAT_LOG_LEVEL=DEBUG
